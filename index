<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--ink:#0d0d0d;--ink-soft:#3a3a3a;--ink-muted:#888;--paper:#f7f5f0;--paper-alt:#efede7;--gold:#b89a5a;--gold-light:#d4b97a;--white:#ffffff;--border:rgba(13,13,13,0.10);--font-display:'Cormorant Garamond',Georgia,serif;--font-body:'DM Sans',sans-serif}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--font-body);font-weight:300;font-size:16px;line-height:1.7;overflow-x:hidden}
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:1.4rem 4rem;background:rgba(247,245,240,0.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.nav-logo{font-family:var(--font-display);font-size:1.05rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink);text-decoration:none}
.nav-logo span{color:var(--gold)}
.nav-links{display:flex;gap:2.5rem;list-style:none}
.nav-links a{font-size:0.75rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-soft);text-decoration:none;transition:color 0.2s}
.nav-links a:hover{color:var(--gold)}
.nav-cta{font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink);text-decoration:none;border:1px solid var(--ink);padding:0.55rem 1.4rem;transition:background 0.25s,color 0.25s}
.nav-cta:hover{background:var(--ink);color:var(--paper)}
.hero{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;padding-top:5rem}
.hero-left{display:flex;flex-direction:column;justify-content:center;padding:6rem 4rem;position:relative}
.hero-left::after{content:'';position:absolute;right:0;top:15%;bottom:15%;width:1px;background:var(--border)}
.hero-eyebrow{font-size:0.7rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--gold);margin-bottom:2rem;display:flex;align-items:center;gap:1rem}
.hero-eyebrow::before{content:'';display:block;width:2.5rem;height:1px;background:var(--gold)}
.hero-title{font-family:var(--font-display);font-size:clamp(3rem,5vw,5.5rem);font-weight:300;line-height:1.08;margin-bottom:2rem;color:var(--ink)}
.hero-title em{font-style:italic;color:var(--gold)}
.hero-sub{font-size:1rem;color:var(--ink-soft);max-width:38ch;line-height:1.8;margin-bottom:3rem}
.hero-actions{display:flex;gap:1.2rem;align-items:center}
.btn-primary{background:var(--ink);color:var(--paper);text-decoration:none;font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;padding:0.9rem 2rem;transition:background 0.25s}
.btn-primary:hover{background:var(--gold)}
.btn-ghost{color:var(--ink-soft);text-decoration:none;font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;padding:0.9rem 0;border-bottom:1px solid var(--border);transition:color 0.2s,border-color 0.2s}
.btn-ghost:hover{color:var(--gold);border-color:var(--gold)}
.hero-right{background:var(--ink);display:flex;flex-direction:column;justify-content:flex-end;padding:4rem;position:relative;overflow:hidden}
.hero-right::before{content:'IG';position:absolute;top:-2rem;right:-1rem;font-family:var(--font-display);font-size:22rem;font-weight:600;color:rgba(255,255,255,0.03);line-height:1;pointer-events:none;user-select:none}
.hero-logo-block{display:flex;flex-direction:column;align-items:center;margin-bottom:2.5rem;padding-bottom:2rem;border-bottom:1px solid rgba(255,255,255,0.08)}
.hero-logo-img{width:140px;height:auto;margin-bottom:0.8rem;filter:drop-shadow(0 4px 12px rgba(0,0,0,0.4))}
.hero-logo-name{font-family:var(--font-display);font-size:1.1rem;font-weight:400;letter-spacing:0.18em;text-transform:uppercase;color:rgba(247,245,240,0.85)}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.08)}
.hero-grid-item{background:var(--ink);padding:2rem;transition:background 0.25s}
.hero-grid-item:hover{background:#1a1a1a}
.hero-grid-item .label{font-size:0.65rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:0.6rem}
.hero-grid-item .value{font-family:var(--font-display);font-size:1.3rem;font-weight:300;color:rgba(247,245,240,0.9);line-height:1.3}
.hero-tagline{margin-top:2.5rem;font-size:0.72rem;letter-spacing:0.1em;color:rgba(255,255,255,0.3);text-transform:uppercase}
.about{padding:8rem 4rem;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 2fr;gap:6rem;align-items:start}
.section-label{font-size:0.65rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--gold);padding-top:0.5rem}
.about-content h2{font-family:var(--font-display);font-size:clamp(2rem,3.5vw,3.2rem);font-weight:300;line-height:1.2;margin-bottom:2rem}
.about-content h2 em{font-style:italic;color:var(--gold)}
.about-content p{color:var(--ink-soft);margin-bottom:1.5rem;max-width:60ch;font-size:1rem}
.about-detail{margin-top:3rem;padding-top:2rem;border-top:1px solid var(--border);display:flex;gap:3rem}
.about-detail-item .d-label{font-size:0.65rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-muted);margin-bottom:0.3rem}
.about-detail-item .d-value{font-size:0.9rem;color:var(--ink)}
.areas{background:var(--paper-alt);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:6rem 4rem}
.areas-inner{max-width:1200px;margin:0 auto}
.areas-header{display:grid;grid-template-columns:1fr 2fr;gap:6rem;margin-bottom:4rem;align-items:end}
.areas-header h2{font-family:var(--font-display);font-size:clamp(2rem,3vw,3rem);font-weight:300;line-height:1.2}
.areas-header p{color:var(--ink-soft);font-size:1rem;max-width:50ch}
.areas-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border:1px solid var(--border)}
.area-card{background:var(--paper-alt);padding:2.5rem 2rem;transition:background 0.25s;position:relative;overflow:hidden}
.area-card:hover{background:var(--white)}
.area-number{font-family:var(--font-display);font-size:3.5rem;font-weight:300;color:rgba(13,13,13,0.06);line-height:1;margin-bottom:1.5rem}
.area-icon{font-size:1.4rem;margin-bottom:1rem}
.area-title{font-family:var(--font-display);font-size:1.25rem;font-weight:400;margin-bottom:0.8rem;color:var(--ink)}
.area-desc{font-size:0.88rem;color:var(--ink-soft);line-height:1.7}
.area-status{margin-top:1.5rem;font-size:0.65rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--gold)}
.approach{padding:8rem 4rem;max-width:1200px;margin:0 auto}
.approach-header{display:grid;grid-template-columns:1fr 2fr;gap:6rem;margin-bottom:5rem;align-items:end}
.approach-header h2{font-family:var(--font-display);font-size:clamp(2rem,3vw,3rem);font-weight:300;line-height:1.2}
.approach-header p{color:var(--ink-soft);max-width:52ch}
.approach-list{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3rem}
.approach-item{padding-top:1.5rem;border-top:1px solid var(--border)}
.approach-item .step{font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);margin-bottom:1rem}
.approach-item h3{font-family:var(--font-display);font-size:1.3rem;font-weight:400;margin-bottom:0.7rem}
.approach-item p{font-size:0.9rem;color:var(--ink-soft);line-height:1.7}
.contact{background:var(--ink);padding:7rem 4rem}
.contact-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center}
.contact-left .eyebrow{font-size:0.65rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--gold);margin-bottom:1.5rem}
.contact-left h2{font-family:var(--font-display);font-size:clamp(2.2rem,4vw,4rem);font-weight:300;color:var(--paper);line-height:1.1;margin-bottom:1.5rem}
.contact-left h2 em{font-style:italic;color:var(--gold)}
.contact-left p{color:rgba(247,245,240,0.55);font-size:1rem;max-width:42ch;line-height:1.8}
.contact-right{display:flex;flex-direction:column;gap:2.5rem}
.contact-block .c-label{font-size:0.65rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:0.5rem}
.contact-block .c-value{font-size:1rem;color:rgba(247,245,240,0.85)}
.contact-block .c-value a{color:rgba(247,245,240,0.85);text-decoration:none;border-bottom:1px solid rgba(247,245,240,0.2);transition:border-color 0.2s,color 0.2s}
.contact-block .c-value a:hover{color:var(--gold-light);border-color:var(--gold)}
.contact-divider{width:100%;height:1px;background:rgba(255,255,255,0.08)}
.contact-cta{display:inline-block;background:var(--gold);color:var(--ink);text-decoration:none;font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;padding:1rem 2.2rem;font-weight:500;transition:background 0.25s;align-self:flex-start}
.contact-cta:hover{background:var(--gold-light)}
footer{background:#080808;padding:2.5rem 4rem;display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(255,255,255,0.05)}
.footer-logo{font-family:var(--font-display);font-size:0.9rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:rgba(247,245,240,0.4);text-decoration:none}
.footer-logo span{color:var(--gold)}
.footer-copy{font-size:0.72rem;color:rgba(255,255,255,0.2);letter-spacing:0.05em}
.footer-links{display:flex;gap:2rem;list-style:none}
.footer-links a{font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.25);text-decoration:none;transition:color 0.2s}
.footer-links a:hover{color:var(--gold)}
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.hero-eyebrow{animation:fadeUp 0.7s ease both;animation-delay:0.1s}
.hero-title{animation:fadeUp 0.7s ease both;animation-delay:0.25s}
.hero-sub{animation:fadeUp 0.7s ease both;animation-delay:0.4s}
.hero-actions{animation:fadeUp 0.7s ease both;animation-delay:0.55s}
.hero-right{animation:fadeUp 0.9s ease both;animation-delay:0.3s}
@media(max-width:900px){nav{padding:1.2rem 1.5rem}.nav-links{display:none}.hero{grid-template-columns:1fr;min-height:auto}.hero-left{padding:6rem 1.5rem 3rem}.hero-left::after{display:none}.hero-right{padding:3rem 1.5rem;min-height:360px}.hero-right::before{font-size:14rem}.about,.approach{padding:5rem 1.5rem;grid-template-columns:1fr;gap:2rem}.areas{padding:5rem 1.5rem}.areas-header{grid-template-columns:1fr;gap:1.5rem}.areas-grid{grid-template-columns:1fr 1fr}.approach-header{grid-template-columns:1fr;gap:1.5rem}.approach-list{grid-template-columns:1fr;gap:2rem}.contact{padding:5rem 1.5rem}.contact-inner{grid-template-columns:1fr;gap:3rem}footer{flex-direction:column;gap:1.2rem;padding:2rem 1.5rem;text-align:center}.footer-links{justify-content:center}.about-detail{flex-direction:column;gap:1.5rem}}
@media(max-width:560px){.areas-grid{grid-template-columns:1fr}.hero-grid{grid-template-columns:1fr}}
</style>
</head>
