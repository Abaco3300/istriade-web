{
  "name": "istriade-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "content:guard": "node scripts/content-guard.mjs",
    "brand:check": "node scripts/brand-integrity.mjs",
    "accessibility:guard": "node scripts/accessibility-guard.mjs",
    "metadata:guard": "node scripts/metadata-distribution-guard.mjs",
    "deploy:check": "node scripts/verify-static-export.mjs && node scripts/metadata-export-guard.mjs",
    "check": "npm run content:guard && npm run brand:check && npm run accessibility:guard && npm run metadata:guard && npm run typecheck && npm run build && npm run deploy:check"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.8.0"
  }
}
